# Variables d'environnement du site CreaLeads
# Copier dans .env.local (local) et dans les Environment Variables Vercel (prod).

# ── Supabase (projet CreaLeads : yokfuqqczorvqunyduig) ──
NEXT_PUBLIC_SUPABASE_URL=https://yokfuqqczorvqunyduig.supabase.co
# Clé service_role — SECRET. Utilisée UNIQUEMENT par /api/onboarding (jamais exposée au navigateur).
SUPABASE_SERVICE_ROLE_KEY=
# Clé anon (publishable) — optionnelle (le formulaire ne touche plus la base directement).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Resend (e-mail d'accès client + notification interne) ──
RESEND_API_KEY=
# Domaine expéditeur à VÉRIFIER dans Resend (sinon l'envoi échoue).
RESEND_FROM=CreaLeads <onboarding@crealeads.fr>
ONBOARDING_NOTIFY_EMAIL=contact.crealeads@gmail.com

# ── Divers ──
DASHBOARD_URL=https://dashboard.crealeads.fr
# Formulaire de contact de la home (existant)
NEXT_PUBLIC_MAKE_WEBHOOK=
